* text=auto
*.png binary
*.apk binary
*.keystore binary

# Windows scripts: keep CRLF so cmd.exe/PowerShell behave predictably
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docs and code: LF everywhere else
*.md text eol=lf
*.js text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.py text eol=lf
